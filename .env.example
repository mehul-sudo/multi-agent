# Multi-Agent AI Assistant for Enterprise Automation
# Comprehensive Environment Variable Configuration Template

# ------------------------------------------------------------------------------
# 1. SERVER CONFIGURATION
# ------------------------------------------------------------------------------
FLASK_APP=app:create_app
FLASK_ENV=development
SECRET_KEY=dev-secret-key-change-in-production
JWT_SECRET_KEY=dev-jwt-secret-key-change-in-production
PORT=5000
DEBUG=True
BACKEND_URL=http://localhost:5000

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (SQLite default for dev, PostgreSQL/MySQL for prod)
# ------------------------------------------------------------------------------
# Dev Default: sqlite:///dev.db
# PostgreSQL Prod: postgresql://user:password@localhost:5432/enterprise_db
# MySQL Prod: mysql+pymysql://user:password@localhost:3306/enterprise_db
DATABASE_URL=sqlite:///dev.db
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

# ------------------------------------------------------------------------------
# 3. CELERY & REDIS DISTRIBUTED QUEUE
# ------------------------------------------------------------------------------
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_TASK_ALWAYS_EAGER=False

# ------------------------------------------------------------------------------
# 4. AI BRAIN & LLM PROVIDER CREDENTIALS
# ------------------------------------------------------------------------------
# Gemini is the primary AI brain for reasoning, planning, streaming, and tool selection.
# OpenAI may be configured as an optional fallback provider.
USE_MOCK_LLM=False
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-lite-latest

# Optional OpenAI fallback (only called if Gemini is unavailable)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o
ANTHROPIC_API_KEY=mock-key-for-dev

# ------------------------------------------------------------------------------
# 5. EMAIL AGENT PROVIDER CONFIGURATION (Resend)
# ------------------------------------------------------------------------------
# Resend is the real email provider. Requires backend human approval before sending.
EMAIL_PROVIDER=resend
# Mode: 'live' (delivers directly to requested recipient) or 'sandbox' (redirects to test recipient)
EMAIL_MODE=live
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM=onboarding@resend.dev
# Test recipient (only used when EMAIL_MODE=sandbox)
RESEND_TEST_RECIPIENT=your_test_email@example.com

# ------------------------------------------------------------------------------
# 6. HTTP / WEBHOOK AGENT DOMAIN SECURITY ALLOWLIST & SSRF GUARDRAILS
# ------------------------------------------------------------------------------
# Comma-separated allowed domain suffixes. Leave empty to allow any public domain.
ALLOWED_WEBHOOK_DOMAINS=example.com,api.github.com,httpbin.org

# ------------------------------------------------------------------------------
# 8. SECURITY & CONCURRENCY LIMITS
# ------------------------------------------------------------------------------
MAX_FILE_SIZE_MB=10
TASK_TIMEOUT_MS=300000
MAX_USER_CONCURRENT_JOBS=10
MAX_WORKFLOW_CONCURRENT_JOBS=5
RATE_LIMIT_LOGIN_PER_MINUTE=10

# Human-in-the-Loop Self-Approval (Development only: set true to test approvals with 1 user)
ALLOW_SELF_APPROVAL_IN_DEVELOPMENT=true

